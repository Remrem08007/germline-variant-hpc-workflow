manifest {
    name = 'germline-variant-hpc-workflow'
    author = 'Rémi-Antoine Joron'
    description = 'Generic germline short-variant discovery workflow for HPC'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.04.0'
}

params {
    input = null
    reference = null
    intervals = null
    known_sites = null
    skip_bqsr = false
    outdir = 'results'
    container_dir = null
    fastp_qualified_quality_phred = 15
    fastp_min_length = 35
    samtools_sort_mem = '2G'
    stub_mode = false

    // Transparent hard-filter starting points. Override in a site/study config when needed.
    snp_qd_min = 2.0
    snp_sor_max = 3.0
    snp_fs_max = 60.0
    snp_mq_min = 40.0
    snp_mq_rank_sum_min = -12.5
    snp_read_pos_rank_sum_min = -8.0

    indel_qd_min = 2.0
    indel_fs_max = 200.0
    indel_sor_max = 10.0
    indel_read_pos_rank_sum_min = -20.0
}

profiles {
    local {
        includeConfig 'conf/base.config'
        includeConfig 'conf/local.config'
    }
    slurm {
        includeConfig 'conf/base.config'
        includeConfig 'conf/slurm.config'
    }
    apptainer {
        includeConfig 'conf/apptainer.config'
    }
    singularity {
        includeConfig 'conf/singularity.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
}
